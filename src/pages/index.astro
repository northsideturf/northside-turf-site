---
// src/pages/index.astro
import '../styles/global.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Northside Turf | Professional Lawn Care</title>
  </head>
  <body class="bg-gray-50 text-gray-900 font-sans antialiased flex flex-col min-h-screen">
    
    <!-- Sticky Contact Bar (Background spans full width) -->
    <div class="sticky top-0 z-50 bg-gray-900 border-b border-gray-700 shadow-lg w-full">
      
      <!-- Invisible Container (Locks to the same width as the rest of the site) -->
      <div class="max-w-6xl mx-auto py-3 px-4 flex flex-col md:flex-row justify-center md:justify-end items-center gap-2 md:gap-6 text-sm md:text-base font-bold text-gray-200">
        <div class="flex items-center gap-3">
          <span>469-525-3822</span>
          <span class="text-gray-600">|</span>
          <a href="tel:469-525-3822" class="text-[#F26522] hover:text-orange-400 transition-colors">Call</a>
          <span class="text-gray-600">|</span>
          <a href="sms:469-525-3822" class="text-[#F26522] hover:text-orange-400 transition-colors">Text</a>
		  <span class="text-gray-600">|</span>
		  <a href="mailto:northsideturftx@gmail.com" class="hover:text-white transition-colors">
          email
        </a>
        </div>
      </div>
      
    </div>

    <!-- Green Logo & Hero Banner -->
    <header class="bg-green-900 py-12 px-4 border-b-8 border-[#F26522] shadow-sm">
      <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-center gap-8 md:gap-12">
        
        <!-- Logo (Now spans wider on mobile, maintains height on desktop) -->
        <img src="/NT-logo-full.png" alt="Northside Turf Logo" class="w-9/12 sm:w-3/4 md:w-auto md:h-100 h-auto drop-shadow-2xl hover:scale-105 transition-transform duration-300 shrink-0" />
        
        <!-- Text -->
        <div class="text-center md:text-left">
          <h1 class="text-4xl md:text-6xl font-extrabold mb-4 uppercase tracking-wide leading-tight text-white drop-shadow-md">
            Reliable Lawn Care
          </h1>
          <p class="text-lg md:text-2xl text-green-100 font-medium max-w-2xl">
            Locally owed and Proudly serving Celina, Prosper, and Gunter, Texas.
          </p>
        </div>

      </div>
    </header>

    <!-- Services Grid Section -->
    <section class="py-20 px-4 max-w-6xl mx-auto flex-grow">
      <h2 class="text-3xl md:text-4xl font-bold text-center mb-12 text-gray-800 uppercase tracking-wide">
        Our Core Services
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <!-- Service 1 -->
        <div class="bg-white p-8 rounded-xl shadow-md border-t-4 border-[#F26522] hover:shadow-lg transition-shadow">
          <h3 class="text-2xl font-bold mb-3 text-green-900">Weekly Lawn Maintenance</h3>
          <p class="text-gray-600 leading-relaxed">
            Consistent, high-quality mowing, edging, and blowing to keep your property looking pristine week after week.
          </p>
        </div>

        <!-- Service 2 -->
        <div class="bg-white p-8 rounded-xl shadow-md border-t-4 border-[#F26522] hover:shadow-lg transition-shadow">
          <h3 class="text-2xl font-bold mb-3 text-green-900">Hedge & Bush Trimming</h3>
          <p class="text-gray-600 leading-relaxed">
            Expert shaping and pruning to maintain the health and appearance of your landscape's greenery.
          </p>
        </div>

        <!-- Service 3 -->
        <div class="bg-white p-8 rounded-xl shadow-md border-t-4 border-[#F26522] hover:shadow-lg transition-shadow">
          <h3 class="text-2xl font-bold mb-3 text-green-900">Clean-Ups</h3>
          <p class="text-gray-600 leading-relaxed">
            Thorough seasonal clean-ups to remove debris, leaves, and overgrowth, restoring your yard's curb appeal.
          </p>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="bg-gray-900 text-gray-400 py-8 px-4 text-center">
      <div class="max-w-6xl mx-auto">
        <div class="text-xl font-black text-white mb-2 uppercase tracking-wide">
          Northside Turf
        </div>
        <p class="mb-4">Serving Celina, Prosper, and Gunter</p>
        <div class="text-sm border-t border-gray-800 pt-6">
          &copy; {new Date().getFullYear()} Northside Turf. All rights reserved.
        </div>
      </div>
    </footer>

  </body>
</html>